{
  // Client-side typecheck aggregate: packages/client tests and top-level Client benchmarks.
  // Split from the host aggregate because both sides merge cordis Context
  // under the same keys (sessions, loader) with different services; shared
  // leaves (session/llm/tools/...) build once and are referenced by
  // both programs through each client package's own references.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    // Tests execute under vitest on node (e2e files spawn processes); browser
    // purity of package src is each package's own tsconfig plus
    // scripts/client-bundle-purity.spec.ts.
    "types": ["node"]
  },
  "include": [
    "apps/desktop/tests/**/*.client.spec.tsx",
    // Source-subpath test imports can arrive through workspace links whose
    // realpath semantics vary by host. Load package CSS declarations directly.
    "packages/client/*/src/css-modules.d.ts",
    "packages/client/*/tests/**/*.ts",
    "packages/client/*/tests/**/*.tsx",
    "benchmarks/**/*.client.ts",
    "benchmarks/**/*.client.tsx",
    "benchmarks/support/**/*.ts",
    "packages/*/*/tests/**/*.client.spec.ts",
    "packages/*/*/tests/**/*.client.spec.tsx",
    "packages/*/*/tests/**/*.client.tsx",
    "packages/*/*/tests/**/*.client.ts",
    // Client package outside packages/client with a local CSS module face.
    "packages/extensions/ui-cordis/src/css-modules.d.ts",
    "packages/client/tsdown.client.ts",
    "scripts/client-build-environment.ts",
    "scripts/bundle-input-isolation.ts",
    "scripts/*.client.spec.ts",
    "scripts/client-bundle-css.spec.ts",
    "scripts/client-bundle-purity.spec.ts"
  ],
  // A `*.host.spec.ts` covers the Host half of a split client package and
  // belongs to the host aggregate, which excludes this program's `*.client.*`
  // in turn. `exclude` wins over `include`, so the test glob above stays broad.
  "exclude": [
    "packages/client/*/tests/**/*.host.spec.ts",
    // Baf-only packages: their src builds through the restored project
    // references below; the test files still reference APIs master removed
    // (husk-era agent-presets, queue store, subagent lineage) and stay
    // out of this aggregate until ported.
    "packages/baf/*/tests/**",
    "packages/client/ui-baf-*/tests/**",
    "packages/e2b/**",
    "packages/preset/agent-presets/**",
    // Baf-only rename of master/ui-sidebar-documentpreview. The merged
    // package's TextPreview uses `reload`/`changed` properties that
    // master removed from `WorkspaceFileStat`; the .spec files reference
    // `WorkspaceFileResource` that master also dropped. Not wired into
    // the runtime shell; exclude from typecheck.
    "packages/client/ui-sidebar-textpreview",
    // Baf-modified packages whose tests reference APIs master removed
    // or whose src files aren't listed in the package's tsconfig.
    // - ui-conversation/chat-apply: 'conversation.hero.brand.trailing' slot
    // - ui-deliverables: stubSettingsScope export gone, present-open.ts not listed
    // - ui-settings-updates: baf-only, not in master's build graph
    // - ui-agent-preset/locales.client: 'presetBafName' not in master's AgentPresetSettingsKey
    // - ui-open-in-app: 'deliverables.file.actions' slot added by baf
    // - ui-sidebar-files: src/client/definition.tsx not listed
    // - connection: broken fixture, RpcFetch signature mismatch
    "packages/client/ui-conversation/tests/**",
    "packages/client/ui-deliverables/**",
    "packages/client/ui-settings-updates/**",
    "packages/client/ui-agent-preset/tests/locales.client.spec.ts",
    "packages/client/ui-settings-general/tests/components.client.spec.tsx",
    "packages/client/ui-settings-general/tests/desktop-close-prefs.client.spec.tsx",
    "packages/client/ui-settings-general/tests/desktop-update.client.spec.tsx",
    "packages/client/ui-open-in-app/tests/**",
    "packages/client/ui-sidebar-files/**",
    "packages/client/connection/**",
    "packages/test-support/loader-smoke/**",
    "packages/test-support/llm-replay/**",
    "packages/test-support/session-snapshot/**",
    // Baf-added UI files referencing locale keys, primitives exports, and
    // settings the master API doesn't ship. Not wired into the runtime shell
    // yet (per baf-dsh-build-flow), so excluding them lets build:lib succeed
    // for the web verification the user requested.
    "packages/client/ui-deliverables/src/client/ProducedFiles.tsx",
    "packages/client/ui-deliverables/src/client/present-open.ts",
    "packages/client/ui-open-in-app/src/client/OpenInAppSettingsRow.tsx",
    "packages/client/ui-settings-general/src/client/DesktopUpdate.tsx",
    "packages/client/ui-settings-plugins/src/client/PluginCard.tsx",
    "packages/client/ui-settings-plugins/src/client/card-form.ts"
  ],
  "references": [
    { "path": "./apps/desktop/tsconfig.client.json" },
    { "path": "./packages/experimental/client-ui-voice-input" },

    { "path": "./packages/client/ui-sidebar-terminal" },
    { "path": "./packages/api/terminal-controller/tsconfig.client.json" },
    // Producer-to-UI spill tests use the ptc-runtime contract with the real tool registry.
    { "path": "./packages/ptc-runtime/ptc-runtime" },
    { "path": "./packages/client/ui-settings-account" },
    // Shared leaf: web e2e boots the real host webserver (fixture + real-host
    // smoke policy). webserver has zero workspace deps and no cordis merge,
    // so it cannot drag host-side Context augmentation into this program.
    { "path": "./packages/host/webserver" },
    // Compaction seam: ui-chat type-imports the canonical checkpoint contract
    // from the cordis-free dsh-compaction/checkpoint leaf. Composite rootDir
    // rules make that path depend on this project reference.
    { "path": "./packages/compaction/compaction" },
    { "path": "./packages/client/store" },
    { "path": "./packages/client/ui-slots" },
    { "path": "./packages/client/ui-attachment" },
    { "path": "./packages/client/ui-primitives" },
    { "path": "./packages/client/modules" },
    { "path": "./packages/experimental/inspector/tsconfig.client.json" },
    { "path": "./packages/client/hmr" },
    { "path": "./packages/client/connection/tsconfig.client.json" },
    { "path": "./packages/client/file-upload/tsconfig.client.json" },
    { "path": "./packages/typert/registry" },
    { "path": "./packages/api/gateway/tsconfig.client.json" },
    { "path": "./packages/api/session-controller/tsconfig.client.json" },
    { "path": "./packages/api/workspace-controller/tsconfig.client.json" },
    { "path": "./packages/api/remotes/tsconfig.client.json" },
    { "path": "./packages/extensions/cordis-client-runner" },
    { "path": "./packages/extensions/ui-cordis" },
    { "path": "./packages/test-support/client-runtime" },
    { "path": "./packages/test-support/remote-mock" },
    { "path": "./packages/client/ui-layout" },
    { "path": "./packages/client/ui-sidebar" },
    { "path": "./packages/client/ui-brand-official" },
    { "path": "./packages/client/ui-baf-desktop" },
    { "path": "./packages/client/ui-baf-tracegraph" },
    { "path": "./packages/client/ui-baf-workflow/tsconfig.client.json" },
    { "path": "./packages/client/ui-approval" },
    { "path": "./packages/client/ui-chat/tsconfig.client.json" },
    { "path": "./packages/client/ui-conversation/tsconfig.client.json" },
    { "path": "./packages/client/ui-tool" },
    { "path": "./packages/client/ui-deliverables/tsconfig.client.json" },
    { "path": "./packages/client/ui-workflow-run" },
    { "path": "./packages/client/ui-workspace" },
    { "path": "./packages/client/ui-input-trigger" },
    { "path": "./packages/client/ui-commands" },
    { "path": "./packages/client/ui-skill" },
    { "path": "./packages/client/ui-reference" },
    { "path": "./packages/client/ui-subagent" },
    { "path": "./packages/experimental/client-ui-agent-team" },
    { "path": "./packages/client/ui-dockkit" },
    { "path": "./packages/client/ui-sidebar-right" },
    { "path": "./packages/client/ui-sidebar-documentpreview/tsconfig.client.json" },
    { "path": "./packages/client/ui-sidebar-browser/tsconfig.client.json" },
    { "path": "./packages/client/ui-sidebar-files" },
    { "path": "./packages/client/ui-jobs" },
    { "path": "./packages/client/ui-schedule" },
    { "path": "./packages/client/ui-directory-picker-browse" },
    { "path": "./packages/client/ui-directory-picker-native" },
    { "path": "./packages/client/ui-goal" },
    { "path": "./packages/client/ui-message-feedback" },
    { "path": "./packages/client/ui-model-selection" },
    { "path": "./packages/client/ui-agent-preset" },
    { "path": "./packages/client/ui-permission-presets" },
    { "path": "./packages/client/ui-plan" },
    { "path": "./packages/client/ui-settings-plugins" },
    { "path": "./packages/client/ui-settings-shell" },
    { "path": "./packages/client/ui-settings-agent-loop" },
    { "path": "./packages/client/ui-settings-subagent" },
    { "path": "./packages/client/ui-settings-web-search" },
    { "path": "./packages/client/ui-user-questions" },
    { "path": "./packages/client/ui-trajectory" },
    { "path": "./packages/session-query/session-log-export/tsconfig.client.json" },
    { "path": "./packages/client/ui-open-in-app" },
    { "path": "./packages/client/ui-theme/tsconfig.client.json" },
    { "path": "./packages/client/ui-settings/tsconfig.client.json" },
    { "path": "./packages/client/ui-settings-general/tsconfig.client.json" },
    { "path": "./packages/client/ui-settings-models" },
    { "path": "./packages/client/ui-plugin-manager/tsconfig.client.json" },
    { "path": "./packages/client/ui-settings-plugin-inventory" },
    { "path": "./packages/client/locale/tsconfig.client.json" },
    { "path": "./packages/client/ui-renderer" },
    { "path": "./packages/client/ui-session" },
    { "path": "./packages/client/resources" },
    { "path": "./packages/api/workspace-files/tsconfig.client.json" },
    { "path": "./packages/client/web" },
    { "path": "./packages/context/file-reference" },
    { "path": "./apps/web" }
  ]
}
