# Hidden local probe scripts used for live web-walk verification
# (dot-prefixed .mjs under apps/web are session-local tools, never committed:
# .auto-*, .diag*, .demo*, .verify-*, .smoke*, .nudge-*, .continue-*, …).
apps/web/.*.mjs
# Local dev-server logs (web host, build output captures)
logs/
.artifacts/
.dsh-build/
.playwright-mcp/
.orig
.worktrees/
worktrees/
.agents/worktrees/
.typert-*/
native/system/test/bin/
# Stale tsc build output that wrote `*.d.ts`/`*.js` shadows into src/
# directories of packages that have outDir=lib. Caused by an earlier
# misconfigured tsc invocation; deletes them on each clean run. Per
# `baf-dsh-stale-src-js-shadowing` memory, vitest will load these stale
# files and fail with "X is not a function" when they shadow current .ts.
packages/**/src/**/*.d.ts
packages/**/src/**/*.js
packages/**/src/**/*.d.ts.map
packages/**/src/**/*.js.map
apps/**/src/**/*.d.ts
apps/**/src/**/*.js
apps/**/src/**/*.d.ts.map
apps/**/src/**/*.js.map

# Chunked host build scratch list (regenerated per machine)
rebuild-list.tmp.json
vitest-client.tmp.json
