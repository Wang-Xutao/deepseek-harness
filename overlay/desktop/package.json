{
  "name": "baf-dsh",
  "version": "0.0.3",
  "description": "baf-dsh desktop shell over DeepSeek Harness web",
  "author": "BAF",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "tsc && electron .",
    "dist": "tsc && node ../scripts/electron-builder.mjs",
    "dist:dir": "tsc && node ../scripts/electron-builder.mjs --dir",
    "install-electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
