{
  "name": "@deepseek-ai/dsh-client-ui-settings-baf-standard",
  "description": "BAF 工程规范 read-only settings overview + host Remote over the workspace baseline (.baf/baseline.yml)",
  "version": "0.1.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-baf-standard"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "host": {
      "inject": [
        "@deepseek-ai/dsh-baf-core",
        "@deepseek-ai/dsh-baf-guard",
        "@deepseek-ai/dsh-baf-quality",
        "@deepseek-ai/dsh-baf-scaffold",
        "@deepseek-ai/dsh-baf-standard",
        "@deepseek-ai/dsh-sandbox-policy",
        "@deepseek-ai/dsh-session",
        "@deepseek-ai/dsh-typert-protocol"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-baf-core": "workspace:^",
    "@deepseek-ai/dsh-baf-guard": "workspace:^",
    "@deepseek-ai/dsh-baf-quality": "workspace:^",
    "@deepseek-ai/dsh-baf-scaffold": "workspace:^",
    "@deepseek-ai/dsh-baf-standard": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-baf-core": "workspace:^",
    "@deepseek-ai/dsh-baf-guard": "workspace:^",
    "@deepseek-ai/dsh-baf-quality": "workspace:^",
    "@deepseek-ai/dsh-baf-scaffold": "workspace:^",
    "@deepseek-ai/dsh-baf-standard": "workspace:^",
    "@deepseek-ai/dsh-baf-workflow": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@testing-library/react": "^16.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types/**/*.d.ts",
    "lib/types/types.js"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  }
}
