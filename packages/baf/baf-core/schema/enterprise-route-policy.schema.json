{
  "$id": "https://deepseek-ai.local/dsh/baf/enterprise-route-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnterpriseRoutePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policyId",
    "version",
    "allowSessionOverride",
    "default",
    "allowed",
    "fallbackPolicy"
  ],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "allowSessionOverride": { "type": "boolean" },
    "default": { "$ref": "#/$defs/modelRef" },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "capabilities", "fallbackGroup"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reasoning",
                "coding",
                "structured-output",
                "long-context",
                "tool-use",
                "low-latency"
              ]
            }
          },
          "fallbackGroup": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fallbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "groups"],
      "properties": {
        "mode": { "type": "string", "const": "approved-only" },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/modelRef" }
          }
        }
      }
    }
  },
  "$defs": {
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
