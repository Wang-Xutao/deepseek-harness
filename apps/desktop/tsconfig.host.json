{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../packages/boot/app-boot"
    },
    {
      "path": "../../packages/util/home-paths"
    },
    {
      "path": "../../packages/credentials/deepseek-account"
    },
    {
      "path": "../../packages/api/gateway/tsconfig.host.json"
    },
    {
      "path": "../../packages/client/ui-sidebar-browser/tsconfig.host.json"
    },
    {
      "path": "../../packages/client/shortcuts/tsconfig.host.json"
    },
    {
      "path": "../../packages/util/atomic-write"
    },
    {
      "path": "../../packages/client/product-analytics/tsconfig.host.json"
    }
  ],
  "exclude": [
    "src/client",
    // Baf-only orphan files: depend on baf-only DESKTOP_IPC events
    // (pluginsUpdate/updatesCheck/updatesInstall/updatesState) and
    // helpers (createSeedMetadata) that master refactored away. Not
    // wired into main.ts at runtime; exclude so build:lib passes.
    "src/preload.ts",
    "src/seed-store.ts"
  ]
}
